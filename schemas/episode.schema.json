{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sceneify episode document",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "episode"],
  "properties": {
    "format": {"const": "sceneify-episode"},
    "version": {"const": 1},
    "episode": {"$ref": "#/$defs/episode"}
  },
  "$defs": {
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sceneName", "tickRate", "duration", "events", "meta"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sceneName": {"type": "string"},
        "tickRate": {"type": "number", "exclusiveMinimum": 0},
        "duration": {"type": "number", "minimum": 0},
        "events": {
          "type": "array",
          "items": {"$ref": "#/$defs/event"}
        },
        "meta": {"type": "object"}
      }
    },
    "event": {
      "type": "object",
      "required": ["t", "kind"],
      "properties": {
        "t": {"type": "number", "minimum": 0},
        "kind": {"enum": ["input", "semantic", "marker"]},
        "action": {"type": "string"},
        "name": {"type": "string"},
        "value": {},
        "nodeId": {"type": ["string", "null"]},
        "data": {"type": "object"},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
