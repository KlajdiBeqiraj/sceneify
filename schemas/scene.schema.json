{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sceneify scene document",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "scene"],
  "properties": {
    "format": {"const": "sceneify-scene"},
    "version": {"const": 2},
    "scene": {"$ref": "#/$defs/scene"}
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}],
      "items": false
    },
    "transform": {
      "type": "object",
      "required": ["id", "parentId", "tags", "position", "rotation", "scale", "visible", "material", "physics", "meta"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "parentId": {"type": ["string", "null"]},
        "tags": {"type": "array", "items": {"type": "string"}},
        "position": {"$ref": "#/$defs/vec3"},
        "rotation": {"$ref": "#/$defs/vec3"},
        "scale": {"$ref": "#/$defs/vec3"},
        "visible": {"type": "boolean"},
        "material": {
          "type": ["object", "null"],
          "properties": {
            "color": {"type": "string"},
            "opacity": {"type": "number", "minimum": 0, "maximum": 1},
            "wireframe": {"type": "boolean"},
            "roughness": {"type": "number", "minimum": 0, "maximum": 1},
            "metalness": {"type": "number", "minimum": 0, "maximum": 1},
            "baseColorTexture": {"type": ["string", "null"]},
            "normalTexture": {"type": ["string", "null"]},
            "metallicRoughnessTexture": {"type": ["string", "null"]},
            "textureRepeat": {
              "type": "array",
              "prefixItems": [
                {"type": "number", "exclusiveMinimum": 0},
                {"type": "number", "exclusiveMinimum": 0}
              ],
              "items": false
            }
          },
          "required": ["color", "opacity", "wireframe", "roughness", "metalness"]
        },
        "physics": {
          "type": ["object", "null"],
          "properties": {
            "body": {"enum": ["fixed", "kinematic", "dynamic"]},
            "collider": {"enum": ["cuboid", "ball", "capsule", "hull"]},
            "sensor": {"type": "boolean"},
            "mass": {"type": "number", "exclusiveMinimum": 0}
          },
          "required": ["body", "collider", "sensor", "mass"]
        },
        "meta": {"type": "object"}
      }
    },
    "mesh": {
      "allOf": [
        {"$ref": "#/$defs/transform"},
        {
          "type": "object",
          "required": ["kind", "source", "format"],
          "properties": {
            "kind": {"const": "mesh"},
            "source": {"type": "string"},
            "format": {"type": ["string", "null"]}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "object": {
      "allOf": [
        {"$ref": "#/$defs/transform"},
        {
          "type": "object",
          "required": ["kind", "label"],
          "properties": {
            "kind": {"const": "object"},
            "label": {"type": ["string", "null"]}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "primitive": {
      "allOf": [
        {"$ref": "#/$defs/transform"},
        {
          "type": "object",
          "required": ["kind", "primitive", "size", "radius", "height"],
          "properties": {
            "kind": {"const": "primitive"},
            "primitive": {"enum": ["box", "sphere", "capsule", "plane"]},
            "size": {"$ref": "#/$defs/vec3"},
            "radius": {"type": "number", "exclusiveMinimum": 0},
            "height": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "position", "label", "description", "color", "visible", "meta"],
      "properties": {
        "kind": {"const": "annotation"},
        "id": {"type": "string", "minLength": 1},
        "position": {"$ref": "#/$defs/vec3"},
        "targetId": {"type": ["string", "null"]},
        "offset": {"$ref": "#/$defs/vec3"},
        "label": {"type": ["string", "null"]},
        "description": {"type": ["string", "null"]},
        "color": {"type": "string"},
        "visible": {"type": "boolean"},
        "meta": {"type": "object"}
      }
    },
    "trajectory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "points", "color", "lineWidth", "closed", "visible", "meta"],
      "properties": {
        "kind": {"const": "trajectory"},
        "id": {"type": "string", "minLength": 1},
        "points": {"type": "array", "items": {"$ref": "#/$defs/vec3"}},
        "color": {"type": "string"},
        "lineWidth": {"type": "number", "exclusiveMinimum": 0},
        "closed": {"type": "boolean"},
        "visible": {"type": "boolean"},
        "meta": {"type": "object"}
      }
    },
    "prefab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rootId", "meshes", "objects", "primitives", "gameRoles"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": ["string", "null"]},
        "rootId": {"type": "string", "minLength": 1},
        "meshes": {"type": "array", "items": {"$ref": "#/$defs/mesh"}},
        "objects": {"type": "array", "items": {"$ref": "#/$defs/object"}},
        "primitives": {"type": "array", "items": {"$ref": "#/$defs/primitive"}},
        "gameRoles": {
          "type": "object",
          "additionalProperties": {
            "enum": ["none", "player-spawn", "pickup", "hazard", "checkpoint", "goal"]
          }
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "name", "background", "environment", "meshes", "objects", "primitives", "annotations", "trajectories", "game"],
      "properties": {
        "schemaVersion": {"const": 2},
        "name": {"type": "string"},
        "background": {"type": "string"},
        "environment": {"type": ["object", "null"]},
        "meshes": {"type": "array", "items": {"$ref": "#/$defs/mesh"}},
        "objects": {"type": "array", "items": {"$ref": "#/$defs/object"}},
        "primitives": {"type": "array", "items": {"$ref": "#/$defs/primitive"}},
        "annotations": {"type": "array", "items": {"$ref": "#/$defs/annotation"}},
        "trajectories": {"type": "array", "items": {"$ref": "#/$defs/trajectory"}},
        "game": {"type": ["object", "null"]},
        "prefabs": {"type": "array", "items": {"$ref": "#/$defs/prefab"}},
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "environmentMap": {"type": ["string", "null"]},
            "environmentPreset": {"type": ["string", "null"]},
            "grid": {"type": "boolean"},
            "helpers": {"type": "boolean"},
            "shadows": {"type": "boolean"},
            "exposure": {"type": "number", "exclusiveMinimum": 0},
            "title": {"type": "string"},
            "subtitle": {"type": "string"},
            "fog": {"type": ["object", "null"]},
            "camera": {"type": ["object", "null"]}
          }
        }
      }
    }
  }
}
